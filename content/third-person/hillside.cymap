# hillside.cymap — "The Hillside", the level of samples/14-third-person.
#
# The source a cook reads: the RTS test map's format and cook (content/rts/README.md has the
# statement reference; samples/13-rts-api/map/map_cook.h is the cook). One statement a line; `#`
# starts a comment. Every position is in world metres.
#
# A walled courtyard of flagstones, flat at height zero, in a valley of meadow and woods: a hill
# rises east of it — the slope the hero runs up — and wooded ridges close the valley to the north
# and the west, with a pond in the south-west. The courtyard's stairs, platform, ramp, walls and
# arch are not here: they are the host's level pieces (samples/14-third-person/host/level.cpp),
# boxes the cook has no kit mesh for, collided and drawn beside what this map places.

map "The Hillside"
seed 0x14B1115D
# The terrain: 128 m from (-64, -64), two 64-quad tiles a side, so a sample a metre.
extent -64 -64 128 2
generator 40 0.8 4 0.0
water -1.2
sun -0.45 -0.68 -0.58 26000
# The courtyard: the square the game's level runs on, flat at height zero.
base -14 -16 14 14
company 0 0

texture stone content/beauty/textures/stone_albedo.png
texture gravel content/beauty/textures/gravel_albedo.png
texture copper content/beauty/textures/copper_albedo.png

# --- Terrain layers --------------------------------------------------------------------------------
layer 0 grass 0.27 0.40 0.15 noise 3.0 0.38
layer 1 dirt 0.42 0.32 0.21 noise 1.5 0.32
layer 2 rock 0.46 0.44 0.41 stone 4.0 0.55
layer 3 sand 0.66 0.59 0.44 noise 2.0 0.22
layer 4 flagstone 0.31 0.28 0.24 stone 2.0 0.70
layer 5 meadow 0.36 0.45 0.18 noise 5.0 0.42
layer 6 moss 0.24 0.33 0.14 noise 1.2 0.35
slope-layer 2 30 42
shore-layer 3 1.0

# --- The stack, in order ----------------------------------------------------------------------------
noise 28 1.4 3
# The hill east of the courtyard: its flank begins at the courtyard's wall.
mound 36 -4 24 7.5
# Ridges closing the valley: north, north-west and west, and a knoll south-east.
mound -6 -54 20 9.0
mound 26 -50 16 7.0
mound -50 -30 18 8.5
mound -52 18 16 6.0
mound 40 44 16 5.0
mound 8 52 14 4.0
# The pond, south-west.
mound -32 36 14 -4.2
# A shoulder on the hill's north side, raised by an author's stroke.
brush raise 8 0.6 0.6 : 30 -22 38 -18 46 -16 52 -8
# The courtyard, level, and its edges eased into the valley.
flatten -14 -16 14 14 0
brush smooth 5 1.0 0.5 passes 8 : -14 -16 -14 -4 -14 8 -14 14 -2 14 10 14 14 14 14 4 14 -6 14 -16 2 -16 -8 -16
# The path south out of the arch, and one round to the pond.
road 3 1 : 0 14 0 20 -2 28 -6 34 -12 40
road 2.5 1 : -6 26 -14 28 -20 30
# Paint: the flagstones over the whole courtyard, in broad strokes; then worn to dirt by the arch,
# meadow and moss outside.
brush paint 6 1.0 0.15 layer 4 : -10 -12 10 -12 10 -5 -10 -5 -10 2 10 2 10 9 -10 9 -10 12 10 12
brush paint 2 0.6 0.5 layer 1 : 0 13 0 10 0 6
brush paint 9 0.8 0.6 layer 5 : 24 10 30 18 18 24
brush paint 9 0.8 0.6 layer 5 : -26 -8 -28 2 -26 -16
brush paint 5 0.8 0.5 layer 6 : -22 -22 -18 -26
brush paint 5 0.8 0.5 layer 6 : 36 -26 44 -22

# --- Materials --------------------------------------------------------------------------------------
material terrain 1 1 1 0.92 0 texture albedo
material stone_wall 0.86 0.80 0.70 0.85 0 texture stone
material plaster 0.84 0.78 0.64 0.90 0
material roof_copper 0.90 0.95 0.92 0.55 0.35 texture copper
material roof_wood 0.48 0.22 0.13 0.75 0
material thatch 0.62 0.50 0.27 0.95 0
material wood 0.50 0.34 0.20 0.75 0
material wood_dark 0.28 0.18 0.11 0.80 0
material bark 0.30 0.21 0.14 0.95 0
material leaves_oak 0.24 0.40 0.13 0.85 0
material leaves_pine 0.13 0.27 0.12 0.90 0
material bush 0.22 0.36 0.12 0.90 0
material rock 0.62 0.60 0.56 0.88 0 texture stone
material gold 1.00 0.77 0.25 0.30 1 emission 120 80 15
material iron 0.30 0.30 0.32 0.45 1
material cloth 0.80 0.74 0.62 0.90 0
material team 1 1 1 0.80 0
material skin 0.80 0.58 0.42 0.70 0
material trousers 0.26 0.22 0.18 0.90 0
material straw 0.78 0.66 0.36 0.90 0
material crop 0.36 0.52 0.16 0.90 0
material beacon 0.90 0.90 0.85 0.20 0 emission 40000 20000 6000
material water 0.05 0.17 0.22 0.06 0
# The courtyard's stone, the level pieces are drawn in (host/level.cpp).
material flagstone 0.80 0.76 0.68 0.82 0 texture stone
material capstone 0.66 0.63 0.58 0.78 0 texture gravel
# The hero (host/hero_mesh.h).
material hero_skin 0.82 0.58 0.44 0.62 0
material hero_hair 0.17 0.10 0.06 0.75 0
material hero_shirt 0.12 0.36 0.52 0.80 0
material hero_trousers 0.30 0.27 0.22 0.88 0
material hero_boots 0.20 0.13 0.08 0.70 0
material hero_leather 0.45 0.27 0.13 0.72 0

# --- Foliage --------------------------------------------------------------------------------------
species pine tree_pine canopy 0.9 1.6 2.4 0.85 1.0 0.85 1.10 1.05 0.90
species oak tree_oak canopy 0.9 1.5 3.0 0.95 1.05 0.80 1.15 1.10 0.85
species bush bush understory 0.6 1.3 1.0 0.90 1.0 0.80 1.10 1.10 0.90
species boulder boulder scatter 0.5 1.6 1.4 0.95 0.95 0.95 1.05 1.0 0.95
rule pine 2400 2.2 10 altitude 1.5 3.0 40 50 slope 0 0 30 38 noise 0.25 0.40 1 1 noise-metres 30
rule oak 900 3.2 8 altitude -0.5 0.0 3.0 5.5 slope 0 0 16 24 noise 0.35 0.50 1 1 noise-metres 26
rule bush 2400 1.2 2 altitude -0.6 -0.2 30 40 slope 0 0 30 40
rule boulder 280 2.0 4 slope 10 18 60 70
# Where nothing grows: the courtyard and its approaches, the path the hero runs up the hill, and
# the ground in front of the camera's first frames.
exclude -17 -19 17 17 feather 1
exclude 14 -9 34 3 feather 2
exclude -3 14 3 30 feather 1
exclude -9 24 -1 32
exclude 30 -12 42 6 feather 2

# --- Placements -----------------------------------------------------------------------------------
# Round the courtyard: a house on each side, a well, a barn's worth of crates and logs.
place house building -10 -12 yaw 0
place house building 10 9 yaw 180
place house building -10 8 yaw 90
place well building -7 -2
place crate prop 8 -12 yaw 15
place crate prop 9.2 -11.4 yaw 40 scale 0.8
place crate prop 8.4 -10.6 yaw 70 scale 0.9
place log_pile resource 11 -11 yaw 90
place banner prop -4 12 team 1
place banner prop 4 12 team 1
place tent prop -9 -6 yaw 60
# Fences along the valley's road.
place fence prop -3 18 yaw 90
place fence prop -3 20 yaw 90
place fence prop -3 22 yaw 90
place fence prop 3 18 yaw 90
place fence prop 3 20 yaw 90
place fence prop 3 22 yaw 90
# The hill: boulders and an outcrop on its shoulder.
place outcrop prop 44 -12 yaw 25
place boulder resource 30 6 scale 1.3
place boulder resource 26 -10 yaw 50 scale 1.1
place rock_pile resource 42 4 yaw 120
# Down the valley: a dock on the pond, a watchtower on the knoll.
place dock prop -24 30 yaw 30
place watchtower building 40 40 yaw 20
place water_plane water -32 36 scale 1
