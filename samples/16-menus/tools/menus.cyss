/* samples/16-menus: the menus' own look, over whichever theme is in effect. */
.screen { background-color: #0b0f16; }
.overlay { background-color: #05080ccc; }
.menu-panel {
    background-color: #141b26; border-color: #2f3b52; border-width: 1; corner-radius: 10;
    padding-left: 28; padding-right: 28; padding-top: 22; padding-bottom: 22; gap: 10;
}
.title { color: #e8b64c; font-size: 28; }
.subtitle { color: #8a93a6; }
.hint { color: #6b7488; font-size: 11; }
.menu-button { min-height: 36; }
.setting { gap: 12; align-items: center; min-height: 30; }
.setting-name { min-width: 170; }
.setting-column { min-width: 120; color: #8a93a6; }
.binding { min-width: 120; }
.slot {
    width: 58; height: 58; corner-radius: 6; padding-left: 4; padding-right: 4;
    background-color: #1b2230; border-color: #33405a; border-width: 1;
}
.slot:hover { background-color: #26324a; }
.held { border-color: #e8b64c; border-width: 2; }
.item-name { color: #e8b64c; font-size: 16; }
.details { gap: 6; width: 170; }
