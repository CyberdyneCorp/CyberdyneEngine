#ifndef CY_CORE_ASSETS_TOOLCHAIN_GENERATED_H
#define CY_CORE_ASSETS_TOOLCHAIN_GENERATED_H
// GENERATED by src/core/assets/CMakeLists.txt from deps/manifest.toml and deps/host-tools.toml. Do
// not edit: edit the manifests, or the function that reads them.
//
// This is the answer to M6 design.md §1.3 and M7 task 1.1 — the derivation key that was blind to
// the toolchain. The list below is generated so that adding a dependency without adding it to every
// derivation key is impossible rather than discouraged.
//
// It lives at layer 0 with the derivation key rather than in tools/build/, because the three
// producers that need it — the importer at layer 7, the build graph at layer 7 and the shader cache
// at the backends layer — cannot all reach a tool. M6 generated it under tools/build/ and that is
// exactly why `cy::import::import_derivation_key` could not contribute it.

#define CY_TOOLCHAIN_COMPILER "@CY_TOOLCHAIN_COMPILER@"
#define CY_TOOLCHAIN_FLAGS "@CY_TOOLCHAIN_FLAGS@"
#define CY_TOOLCHAIN_TARGET "@CY_TOOLCHAIN_TARGET@"
#define CY_TOOLCHAIN_LIBRARIES "@CY_TOOLCHAIN_LIBRARIES@"

// The standard library's own version, from the macro the library itself defines. Read here rather
// than derived from the compiler: clang against libstdc++ is the ordinary configuration on a Linux
// developer machine, and a fingerprint that inferred libc++ from "Clang" would key two different
// standard libraries identically.
// <version> is included so that the standard library's own version macro is defined before it is
// read: `__GLIBCXX__` exists only once a libstdc++ header has been seen.
#include <version>

#define CY_TOOLCHAIN_STRINGIFY_(x) #x
#define CY_TOOLCHAIN_STRINGIFY(x) CY_TOOLCHAIN_STRINGIFY_(x)

#if defined(_LIBCPP_VERSION)
#define CY_TOOLCHAIN_STDLIB "libc++ " CY_TOOLCHAIN_STRINGIFY(_LIBCPP_VERSION)
#elif defined(__GLIBCXX__)
#define CY_TOOLCHAIN_STDLIB "libstdc++ " CY_TOOLCHAIN_STRINGIFY(__GLIBCXX__)
#else
#define CY_TOOLCHAIN_STDLIB "unknown"
#endif

#endif  // CY_CORE_ASSETS_TOOLCHAIN_GENERATED_H
