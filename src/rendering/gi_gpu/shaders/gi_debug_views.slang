// SPDX-License-Identifier: MIT
// CyberGI on the device: the GI debug views through the software world tier. Issue #35.
//
//   cyGiDebugExposure   the views' exposure from the frame's own indirect diffuse; clears the leak
//                       suspects. One workgroup.
//   cyGiDebugView       one frame pixel a thread: the view gi_debug_views_common.slang draws.
//   cyGiDebugSuspects   `GiProbeVisibility`'s second half: the leak suspects as discs.
//
// The ray query twin of `cyGiDebugView` is gi_debug_views_hardware.slang's. Regenerated by
// regenerate.py.

#include "gi_debug_views_common.slang"

[shader("compute")]
[numthreads(256, 1, 1)]
void cyGiDebugExposure(uint3 thread : SV_GroupThreadID) {
    gdExposurePass(thread.x);
}

[shader("compute")]
[numthreads(8, 8, 1)]
void cyGiDebugView(uint3 thread : SV_DispatchThreadID) {
    gdDrawPixel<GiSoftwareTier>(thread);
}

[shader("compute")]
[numthreads(8, 8, 1)]
void cyGiDebugSuspects(uint3 thread : SV_DispatchThreadID) {
    gdSuspectPass(thread);
}
