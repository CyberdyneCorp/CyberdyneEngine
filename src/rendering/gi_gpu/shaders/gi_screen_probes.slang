// SPDX-License-Identifier: MIT
// CyberGI on the device: the screen-probe final gather through the software world tier. Issue #35.
//
//   cyGiProbePlace       `ScreenProbeGather::place`: a uniform probe a tile, an adaptive probe a
//                        half-tile cell the uniform ones cannot interpolate. No tier: it reads the
//                        surfaces alone.
//   cyGiProbeTrace       `trace_probe` for every placed probe, one workgroup a probe: the stand-in,
//                        the reprojected history, the guide, a lane a ray through the uploaded
//                        field, and the temporal blend.
//   cyGiProbeIntegrate   `integrate` for every cell of the resolve grid: the probes about it,
//                        weighted by plane distance and normal, into the noisy signals the denoiser
//                        reads.
//
// The ray query twins are gi_screen_probes_hardware.slang's. Regenerated by regenerate.py.

#include "gi_screen_probes_common.slang"

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiProbePlace(uint3 thread : SV_DispatchThreadID) {
    spPlace(thread.x);
}

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiProbeTrace(uint3 group : SV_GroupID, uint3 lane : SV_GroupThreadID) {
    spTrace<GiSoftwareTier>(group.x, lane.x);
}

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiProbeIntegrate(uint3 thread : SV_DispatchThreadID) {
    spIntegrate<GiSoftwareTier>(thread.x);
}
