// SPDX-License-Identifier: MIT
// CyberGI on the device: the screen-probe final gather through the software world tier. Issue #35.
//
//   cyGiProbePlace       `ScreenProbeGather::place`: a uniform probe a tile, and each half-tile
//                        cell the uniform ones cannot interpolate marked a candidate. No tier: it
//                        reads the surfaces alone.
//   cyGiProbeRank        the candidates' adaptive slots in cell order, one workgroup: the first
//                        `capacity` placed, the rest refused, as `place` refuses them.
//   cyGiProbeTrace       `trace_probe` for every placed probe, one workgroup a probe: the stand-in,
//                        the reprojected history, the guide, a lane a ray through the uploaded
//                        field, and the temporal blend.
//   cyGiProbeFilter      `filter`: each probe's coefficients averaged with its uniform neighbours'
//                        on its own surface, into the coefficients the pixels integrate. No tier.
//   cyGiProbeIntegrate   `integrate` for every cell of the resolve grid: the probes about it,
//                        weighted by plane distance and normal, into the noisy signals the denoiser
//                        reads.
//
// The ray query twins are gi_screen_probes_hardware.slang's. Regenerated by regenerate.py.

#include "gi_screen_probes_common.slang"

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiProbePlace(uint3 thread : SV_DispatchThreadID) {
    spPlace(thread.x);
}

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiProbeRank(uint3 lane : SV_GroupThreadID) {
    spRank(lane.x);
}

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiProbeTrace(uint3 group : SV_GroupID, uint3 lane : SV_GroupThreadID) {
    spTrace<GiSoftwareTier>(group.x, lane.x);
}

/// The same trace in a workgroup of one 32-lane wave, for a probe of at most 32 rays: the second
/// wave of the 64-lane group would only wait at its barriers.
[shader("compute")]
[numthreads(32, 1, 1)]
void cyGiProbeTraceNarrow(uint3 group : SV_GroupID, uint3 lane : SV_GroupThreadID) {
    spTrace<GiSoftwareTier>(group.x, lane.x);
}

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiProbeFilter(uint3 thread : SV_DispatchThreadID) {
    spFilter(thread.x);
}

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiProbeIntegrate(uint3 thread : SV_DispatchThreadID) {
    spIntegrate<GiSoftwareTier>(thread.x);
}
