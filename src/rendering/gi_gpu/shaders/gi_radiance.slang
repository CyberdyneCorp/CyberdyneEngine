// SPDX-License-Identifier: MIT
// CyberGI on the device, stage 3: the entry points every device with compute has. Issue #35.
//
//   cyGiGatherProbes      `RadianceCache::gather_probe` over the selected probes, software tier.
//   cyGiSampleProbes      `RadianceCache::sample` at a batch of query points.
//   cyGiBuildScreenHzb    one level of the screen tier's nearest-depth pyramid.
//   cyGiTraceScreen       `ScreenTracer::trace` for a batch of rays (`kGpScreenHzb.y` accelerates).
//   cyGiTraceSoftware     the software world tier alone: `SoftwareTracer::trace` and `::radiance`.
//   cyGiTraceTiered       `TieredTracer::trace` with the software tier as its world tier.
//
// The hardware tier's entry points are gi_hardware.slang's, so none of these declares a top level
// and a device without ray queries creates every one of them. Regenerated by regenerate.py.

#include "gi_probe_common.slang"

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiGatherProbes(uint3 group : SV_GroupID, uint3 lane : SV_GroupThreadID) {
    gpGatherProbe<GiSoftwareTier>(group.x, lane.x);
}

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiSampleProbes(uint3 thread : SV_DispatchThreadID) {
    const uint query = thread.x;
    if (query >= giDispatch.count) {
        return;
    }
    const float3 position = giProbes.queries[query * 2u].xyz;
    const float3 normal = giProbes.queries[(query * 2u) + 1u].xyz;
    giProbes.samples[query] = gpSample(position, normal, giDispatch.frame);
}

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiBuildScreenHzb(uint3 thread : SV_DispatchThreadID) {
    // `giDispatch.frame` is the level being written; level 0 is the depth buffer with sky at
    // +inf, and every level above takes the nearest of the (up to) four texels below it.
    const uint level = giDispatch.frame;
    const uint4 shape = giProbes.constants[kGpHzbLevels + level];
    const uint texel = thread.x;
    if (texel >= shape.y * shape.z) {
        return;
    }
    const uint x = texel % shape.y;
    const uint y = texel / shape.y;
    if (level == 0u) {
        const float depth = giProbes.screenDepth[texel];
        giProbes.screenHzb[shape.x + texel] = depth > 0.0f ? depth : 1.0e30f;
        return;
    }
    const uint4 below = giProbes.constants[kGpHzbLevels + level - 1u];
    const uint x0 = min(x * 2u, below.y - 1u);
    const uint x1 = min((x * 2u) + 1u, below.y - 1u);
    const uint y0 = min(y * 2u, below.z - 1u);
    const uint y1 = min((y * 2u) + 1u, below.z - 1u);
    const float a = giProbes.screenHzb[below.x + (y0 * below.y) + x0];
    const float b = giProbes.screenHzb[below.x + (y0 * below.y) + x1];
    const float c = giProbes.screenHzb[below.x + (y1 * below.y) + x0];
    const float d = giProbes.screenHzb[below.x + (y1 * below.y) + x1];
    giProbes.screenHzb[shape.x + texel] = min(min(a, b), min(c, d));
}

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiTraceScreen(uint3 thread : SV_DispatchThreadID) {
    const uint ray = thread.x;
    if (ray >= giDispatch.count) {
        return;
    }
    const float4 origin = giProbes.tierRays[ray * 2u];
    const float4 direction = giProbes.tierRays[(ray * 2u) + 1u];
    const bool accelerated = giProbes.constants[kGpScreenHzb].y != 0u;
    uint reads = 0u;
    const GiTierSample sample =
        gpScreenTrace(origin.xyz, direction.xyz, origin.w, accelerated, reads);
    gpCount(kGpCountDepthReads, reads);
    gpWriteTierResult(ray, sample, reads);
}

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiTraceSoftware(uint3 thread : SV_DispatchThreadID) {
    const uint ray = thread.x;
    if (ray >= giDispatch.count) {
        return;
    }
    const float4 origin = giProbes.tierRays[ray * 2u];
    const float3 unit =
        giNormalisedOr(giProbes.tierRays[(ray * 2u) + 1u].xyz, float3(0.0f, 0.0f, -1.0f));
    gpWriteTierResult(ray, gpWorldTrace<GiSoftwareTier>(origin.xyz, unit, origin.w), 0u);
}

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiTraceTiered(uint3 thread : SV_DispatchThreadID) {
    const uint ray = thread.x;
    if (ray >= giDispatch.count) {
        return;
    }
    const float4 origin = giProbes.tierRays[ray * 2u];
    const float4 direction = giProbes.tierRays[(ray * 2u) + 1u];
    const bool screenPresent = giProbes.constants[kGpScreen].x != 0u;
    uint reads = 0u;
    const GiTierSample sample =
        gpTieredTrace<GiSoftwareTier>(origin.xyz, direction.xyz, origin.w, screenPresent, reads);
    gpCount(kGpCountDepthReads, reads);
    gpWriteTierResult(ray, sample, reads);
}
