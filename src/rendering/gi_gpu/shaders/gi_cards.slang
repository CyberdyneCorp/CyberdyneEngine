// SPDX-License-Identifier: MIT
// CyberGI on the device: the surface cache's card lighting. Issue #35, stage 2.
//
// ================================================================================================
// TWO DISPATCHES, BECAUSE A GATHER READS WHAT THE UPDATE WRITES
// ================================================================================================
//
// `cyGiShadeCards` shades the pages `SurfaceCache::select` chose — one thread per selected page —
// and writes each answer into `results`, never into `cardState`. A card's gather looks up OTHER
// cards' radiance, and some of those cards are being shaded by the same dispatch: writing
// `cardState` in place would make the answer depend on which thread ran first. So the shade reads
// last frame's radiance everywhere, and `cyGiCommitCards` scatters the results into `cardState`
// after it, with the graph's barrier between. That is the device half of `CardSnapshot`, which is
// the host oracle's copy of the same "last frame".
//
// One page, in the order `SurfaceCache::shade` writes it:
//
//     direct      = shaded_direct(lights, position, normal)    the shadow map, else the field
//     accumulated = albedo * CardGather::gather(position, normal)   the sky, and last frame's cards
//     outgoing    = emission + albedo * direct + accumulated
//     error       = relative_change(last frame's outgoing, outgoing)
//
// With no gather rays configured the accumulated term is carried over unchanged, which is the host
// cache's "no indirect source" case.
//
// Regenerated by regenerate.py beside this file; see gi_trace.slang.

#include "gi_gpu_common.slang"

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiShadeCards(uint3 thread : SV_DispatchThreadID) {
    const uint index = thread.x;
    if (index >= giDispatch.count) {
        return;
    }
    const uint handle = giScene.selection[index];
    const float4 position = giScene.cards[handle * 4u];
    const float4 normal = giScene.cards[(handle * 4u) + 1u];
    const float4 albedo = giScene.cards[(handle * 4u) + 2u];
    const float4 emission = giScene.cards[(handle * 4u) + 3u];
    const float3 before = giScene.cardState[handle * 2u].xyz;

    const float3 direct = giShadedDirect(position.xyz, normal.xyz);
    float3 accumulated = giScene.cardState[(handle * 2u) + 1u].xyz;
    if (giScene.constants[kGiCounts].w != 0u) {
        const float3 incoming = giGather(position.xyz, normal.xyz);
        accumulated = albedo.xyz * incoming;
    }
    const float3 reflected = albedo.xyz * direct;
    const float3 after = emission.xyz + reflected + accumulated;
    giScene.results[index * 3u] = float4(direct, giRelativeChange(before, after));
    giScene.results[(index * 3u) + 1u] = float4(accumulated, asfloat(handle));
    giScene.results[(index * 3u) + 2u] = float4(after, 1.0f);
}

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiCommitCards(uint3 thread : SV_DispatchThreadID) {
    const uint index = thread.x;
    if (index >= giDispatch.count) {
        return;
    }
    const float4 accumulated = giScene.results[(index * 3u) + 1u];
    const uint handle = asuint(accumulated.w);
    giScene.cardState[handle * 2u] = float4(giScene.results[(index * 3u) + 2u].xyz, 1.0f);
    giScene.cardState[(handle * 2u) + 1u] = float4(accumulated.xyz, 0.0f);
}
