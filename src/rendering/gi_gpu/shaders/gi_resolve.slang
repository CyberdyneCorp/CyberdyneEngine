// SPDX-License-Identifier: MIT
// CyberGI on the device, stage 4: the per-pixel resolve through the software world tier. Issue #35.
//
//   cyGiResolve   `ScreenResolve::produce` for every pixel of this frame's surface slot: the
//                 radiance cache, one final-gather ray through the uploaded field, and the far-field
//                 sky, combined by confidence; and the rough specular.
//
// The ray query twin is gi_resolve_hardware.slang's, so a device without ray queries creates this
// one alone. Regenerated by regenerate.py.

#include "gi_resolve_common.slang"

[shader("compute")]
[numthreads(64, 1, 1)]
void cyGiResolve(uint3 thread : SV_DispatchThreadID) {
    grResolvePixel<GiSoftwareTier>(thread.x);
}
