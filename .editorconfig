# Editor settings that every contributor's editor can read, so that a file's shape does not depend
# on who last opened it. `.clang-format` is authoritative for C++ once it lands (task 4.2.1); this
# file is what an editor applies before the formatter runs, and the two agree.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{c,cc,cpp,h,hh,hpp,inl,ixx}]
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[{justfile,*.just}]
indent_size = 4

[*.{json,yaml,yml,toml}]
indent_size = 2

[*.{rs,swift}]
indent_size = 4

[*.py]
indent_size = 4

[*.md]
# Markdown gives meaning to a trailing double space, so it is left alone.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
